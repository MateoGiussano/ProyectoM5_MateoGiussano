rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ¿Hay alguien logueado?
    function isSignedIn() {
      return request.auth != null;
    }

    // ¿El usuario logueado es admin? Lo averigua leyendo su documento en users.
    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    // ---------- USUARIOS ----------
    match /users/{userId} {
      // Cada uno lee su propio perfil. El admin lee todos.
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());

      // Solo podés crear TU perfil, y únicamente como "customer".
      allow create: if isSignedIn()
                    && request.auth.uid == userId
                    && request.resource.data.role == "customer";

      // Nadie modifica ni borra perfiles desde la app (el rol se cambia en la consola).
      allow update, delete: if false;
    }

    // ---------- PRODUCTOS ----------
    match /products/{productId} {
      // El catálogo es público: cualquiera puede verlo, aunque no tenga sesión.
      allow read: if true;

      // Solo el admin crea, edita o borra productos.
      allow create, update, delete: if isAdmin();
    }

        // ---------- ÓRDENES ----------
    match /orders/{orderId} {
      // Cada uno ve sus propias órdenes. El admin ve todas.
      allow read: if isSignedIn()
                  && (resource.data.userId == request.auth.uid || isAdmin());

      // Un usuario crea órdenes a SU nombre, en "pending", con la fecha del servidor
      // y con datos válidos.
      allow create: if isSignedIn()
                    && request.resource.data.keys().hasOnly(
                         ["userId", "userEmail", "items", "total", "status", "createdAt"])
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.status == "pending"
                    && request.resource.data.createdAt == request.time
                    && request.resource.data.items is list
                    && request.resource.data.items.size() > 0
                    && request.resource.data.total is number
                    && request.resource.data.total > 0;

      // Solo el admin cambia el estado, y SOLO el estado, a un valor válido.
      allow update: if isAdmin()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status"])
                    && request.resource.data.status in ["pending", "processing", "completed", "cancelled"];

      // Las órdenes no se borran: quedan como historial.
      allow delete: if false;
    }
  }
}